---
import '../styles/global.css';
import Container from '../components/Container.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import { getLangFromUrl, localizePath, switchLocalePath, t, languages, type Lang } from '../i18n/ui';

interface Props {
  title?: string;
  description?: string;
  /** Override the locale when a page is not at a locale-prefixed URL. */
  lang?: Lang;
}

const { title, description, lang: langProp } = Astro.props;
const site = Astro.site ?? new URL('https://lyimou.github.io');
const lang: Lang = langProp ?? getLangFromUrl(Astro.url);
const canonical = new URL(Astro.url.pathname, site).href;

const pageTitle = title
  ? `${title} — ${t(lang, 'site.title')}`
  : `${t(lang, 'site.title')} — ${t(lang, 'site.tagline')}`;
const pageDescription = description ?? t(lang, 'site.description');

/** The other locale, for the language switch control. */
const otherLang: Lang = lang === 'en' ? 'zh' : 'en';
const switchHref = switchLocalePath(Astro.url.pathname, otherLang);
const currentPath = Astro.url.pathname;

const navItems = [
  { href: localizePath(lang, '/'), label: t(lang, 'nav.home') },
  { href: localizePath(lang, '/projects'), label: t(lang, 'nav.projects') },
  { href: localizePath(lang, '/blog'), label: t(lang, 'nav.blog') },
  { href: localizePath(lang, '/about'), label: t(lang, 'nav.about') },
] as const;

const isCurrent = (href: string) => currentPath === href;

/*
 * Shell layout classes (site-header__inner, site-nav-list, …) are defined in
 * src/styles/global.css, NOT in a scoped <style> block here. A scoped rule
 * does not match when its class is passed to a child component, because Astro
 * omits the parent's data-astro-cid attribute on that element's root.
 */
---

<!doctype html>
<html lang={lang === 'zh' ? 'zh-Hant' : 'en'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" hreflang="en" href={switchLocalePath(Astro.url.pathname, 'en')} />
    <link rel="alternate" hreflang="zh-Hant" href={switchLocalePath(Astro.url.pathname, 'zh')} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta name="generator" content={Astro.generator} />
    <!--
      Theme + motion bootstrap, inline and tiny so the correct theme is applied
      before first paint. Without this the page flashes the wrong theme.
    -->
    <script is:inline>
      (() => {
        const root = document.documentElement;
        try {
          const theme = localStorage.getItem('theme');
          const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          if (theme === 'dark' || (theme !== 'light' && prefersDark)) root.classList.add('dark');
          if (localStorage.getItem('motion') === 'reduced') root.classList.add('reduce-motion');
        } catch {
          /* localStorage unavailable — keep defaults */
        }
      })();
    </script>
  </head>
  <body>
    <a href="#main" class="skip-link">{t(lang, 'a11y.skip')}</a>

    <header class="site-header">
      <Container class="site-header__inner">
        <a class="site-brand" href={localizePath(lang, '/')}>{t(lang, 'site.title')}</a>

        <nav aria-label={t(lang, 'nav.main')}>
          <ul class="site-nav-list">
            {
              navItems.map((item) => (
                <li>
                  <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>

        <div class="site-header__controls">
          <ThemeToggle lang={lang} />
          <a class="lang-switch" href={switchHref} hreflang={otherLang} rel="alternate">
            {languages[otherLang]}
          </a>
        </div>
      </Container>
    </header>

    <main id="main" class="site-main">
      <Container>
        <slot />
      </Container>
    </main>

    <footer class="site-footer">
      <Container>
        <p>
          © {new Date().getFullYear()} {t(lang, 'site.title')} · {t(lang, 'footer.builtWith')}
        </p>
      </Container>
    </footer>
  </body>
</html>
