---
import { localizePath, type Lang } from '../i18n/ui';
import { t } from '../i18n/ui';

interface Props {
  currentPage: number;
  lastPage: number;
  /** Base path without a page number, e.g. `/blog`. */
  basePath: string;
  lang: Lang;
}

const { currentPage, lastPage, basePath, lang } = Astro.props;

const pageHref = (n: number) =>
  n === 1 ? localizePath(lang, basePath) : localizePath(lang, `${basePath}/page/${n}`);
---

{
  lastPage > 1 ? (
    <nav class="pagination" aria-label={lang === 'zh' ? '分頁' : 'Pagination'}>
      {currentPage > 1 ? (
        <a class="pagination__link" href={pageHref(currentPage - 1)} rel="prev">
          ← {t(lang, 'blog.prev')}
        </a>
      ) : (
        <span class="pagination__link pagination__link--disabled" aria-disabled="true">
          ← {t(lang, 'blog.prev')}
        </span>
      )}

      <span class="pagination__status">
        {currentPage} / {lastPage}
      </span>

      {currentPage < lastPage ? (
        <a class="pagination__link" href={pageHref(currentPage + 1)} rel="next">
          {t(lang, 'blog.next')} →
        </a>
      ) : (
        <span class="pagination__link pagination__link--disabled" aria-disabled="true">
          {t(lang, 'blog.next')} →
        </span>
      )}
    </nav>
  ) : null
}

<style>
  .pagination {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--divider);
  }

  .pagination__link {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    font-size: 0.9375rem;
  }

  .pagination__link--disabled {
    color: var(--text-muted);
    opacity: 0.5;
  }

  .pagination__status {
    font-size: 0.875rem;
    color: var(--text-muted);
    font-variant-numeric: tabular-nums;
  }
</style>
