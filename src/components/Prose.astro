---
/**
 * Typographic wrapper for long-form content (blog posts, project write-ups).
 *
 * Deliberately scoped typography rather than a global prose plugin: this site
 * has exactly one prose context, so a plugin would add weight for no benefit.
 */
interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<div class:list={['prose', className]}>
  <slot />
</div>

<style>
  .prose {
    max-width: var(--measure-prose);
    color: var(--text);
  }

  .prose :global(h2) {
    margin-top: 3rem;
    margin-bottom: 1rem;
    font-size: 1.875rem;
  }

  .prose :global(h3) {
    margin-top: 2rem;
    margin-bottom: 0.75rem;
    font-size: 1.25rem;
  }

  .prose :global(p),
  .prose :global(ul),
  .prose :global(ol),
  .prose :global(blockquote) {
    margin-block: 1.25rem;
  }

  .prose :global(ul),
  .prose :global(ol) {
    padding-left: 1.5rem;
  }

  .prose :global(li) {
    margin-block: 0.5rem;
  }

  .prose :global(blockquote) {
    border-left: 3px solid var(--divider);
    padding-left: 1rem;
    color: var(--text-muted);
  }

  .prose :global(hr) {
    border: 0;
    border-top: 1px solid var(--divider);
    margin-block: 3rem;
  }

  .prose :global(code) {
    background-color: var(--primary-soft);
    padding: 0.125rem 0.375rem;
    border-radius: 0.25rem;
  }

  /* Code blocks: Astro's Shiki output already supports click-to-copy. */
  .prose :global(pre) {
    background-color: var(--surface);
    border: 1px solid var(--divider);
    border-radius: var(--radius-card);
    padding: 1rem 1.25rem;
    overflow-x: auto;
    margin-block: 1.5rem;
  }

  .prose :global(pre code) {
    background: none;
    padding: 0;
    font-size: 0.875rem;
    line-height: 1.6;
  }

  .prose :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin-block: 1.5rem;
    font-size: 0.9375rem;
  }

  .prose :global(th),
  .prose :global(td) {
    border: 1px solid var(--divider);
    padding: 0.5rem 0.75rem;
    text-align: left;
  }

  .prose :global(th) {
    background-color: var(--primary-soft);
    font-weight: 600;
  }

  .prose :global(img) {
    max-width: 100%;
    height: auto;
    border-radius: var(--radius-card);
  }
</style>
