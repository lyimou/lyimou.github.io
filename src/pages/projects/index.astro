---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectFilter from '../../components/ProjectFilter.astro';
import { getProjects } from '../../lib/content';
import { t } from '../../i18n/ui';

const lang = 'en' as const;
const projects = await getProjects(lang);
---

<BaseLayout
  lang={lang}
  title={t(lang, 'projects.title')}
  description={`Selected projects by Andy Huang — ${projects.length} write-ups covering systems, C++ and machine learning.`}
>
  <h1>{t(lang, 'projects.title')}</h1>
  <p class="lede">{t(lang, 'site.description')}</p>

  <ProjectFilter projects={projects} lang={lang} />
</BaseLayout>

<style>
  .lede {
    color: var(--text-muted);
    max-width: var(--measure-prose);
    margin-bottom: 2rem;
  }
</style>
