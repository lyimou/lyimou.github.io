---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PostListItem from '../../../components/PostListItem.astro';
import Pagination from '../../../components/Pagination.astro';
import { getPosts, getTags, getCategories } from '../../../lib/content';
import { t, localizePath } from '../../../i18n/ui';

const lang = 'zh' as const;
const POSTS_PER_PAGE = 5;

const posts = await getPosts(lang);
const tags = await getTags(lang);
const categories = await getCategories(lang);

const pagePosts = posts.slice(0, POSTS_PER_PAGE);
const lastPage = Math.max(1, Math.ceil(posts.length / POSTS_PER_PAGE));
---

<BaseLayout lang={lang} title={t(lang, 'blog.title')}>
  <h1>{t(lang, 'blog.title')}</h1>

  <div class="blog-layout">
    <div>
      {
        pagePosts.length > 0 ? (
          <ul class="posts">
            {pagePosts.map((post) => (
              <PostListItem post={post} lang={lang} />
            ))}
          </ul>
        ) : (
          <p class="muted">{t(lang, 'blog.empty')}</p>
        )
      }

      <Pagination currentPage={1} lastPage={lastPage} basePath="/blog" lang={lang} />
    </div>

    <aside class="sidebar">
      {
        categories.length > 0 ? (
          <section class="sidebar__group">
            <h2 class="sidebar__heading">{t(lang, 'blog.categories')}</h2>
            <ul class="sidebar__list">
              {categories.map(({ category, count }) => (
                <li>
                  <a
                    href={localizePath(
                      lang,
                      `/categories/${category.toLowerCase().replace(/[^a-z0-9\u4e00-\u9fff]+/g, '-')}`,
                    )}
                  >
                    {category} <span class="count">({count})</span>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        ) : null
      }

      {
        tags.length > 0 ? (
          <section class="sidebar__group">
            <h2 class="sidebar__heading">{t(lang, 'blog.tags')}</h2>
            <ul class="sidebar__list">
              {tags.map(({ tag, count }) => (
                <li>
                  <a
                    href={localizePath(
                      lang,
                      `/tags/${tag.toLowerCase().replace(/[^a-z0-9\u4e00-\u9fff]+/g, '-')}`,
                    )}
                  >
                    {tag} <span class="count">({count})</span>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        ) : null
      }
    </aside>
  </div>
</BaseLayout>

<style>
  .blog-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 15rem;
    gap: 3rem;
    align-items: start;
  }

  .posts {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .muted {
    color: var(--text-muted);
  }

  .sidebar {
    display: grid;
    gap: 2rem;
    position: sticky;
    top: 2rem;
  }

  .sidebar__heading {
    margin: 0 0 0.75rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--divider);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .sidebar__list {
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 0.875rem;
  }

  .sidebar__list li {
    margin-block: 0.2rem;
  }

  .sidebar__list a {
    display: inline-flex;
    align-items: center;
    min-height: 2rem;
    color: var(--text-muted);
  }

  .sidebar__list a:hover {
    color: var(--primary);
    text-decoration: none;
  }

  .count {
    opacity: 0.65;
    font-variant-numeric: tabular-nums;
  }

  @media (max-width: 64rem) {
    .blog-layout {
      grid-template-columns: minmax(0, 1fr);
      gap: 2.5rem;
    }
    .sidebar {
      position: static;
    }
  }
</style>
