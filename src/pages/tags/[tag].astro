---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostListItem from '../../components/PostListItem.astro';
import { getPosts, slugifyTag } from '../../lib/content';
import { t } from '../../i18n/ui';

const lang = 'en' as const;

export async function getStaticPaths() {
  const posts = await getPosts('en');
  const tags = [...new Set(posts.flatMap((p) => p.data.tags))];
  return tags.map((tag) => ({ params: { tag: slugifyTag(tag) }, props: { tag } }));
}

const { tag } = Astro.props;
const posts = (await getPosts('en')).filter((p) => p.data.tags.includes(tag));
---

<BaseLayout lang={lang} title={`${t(lang, 'blog.tags')}: ${tag}`}>
  <p class="crumb"><a href="/tags/">{t(lang, 'blog.tags')}</a></p>
  <h1>{tag}</h1>
  <p class="count">{posts.length} post{posts.length === 1 ? '' : 's'}</p>

  {
    posts.length > 0 ? (
      <ul class="posts">
        {posts.map((post) => (
          <PostListItem post={post} lang={lang} />
        ))}
      </ul>
    ) : (
      <p class="muted">{t(lang, 'blog.empty')}</p>
    )
  }
</BaseLayout>

<style>
  .crumb {
    margin: 0 0 0.5rem;
    font-size: 0.875rem;
  }
  .count {
    color: var(--text-muted);
    font-size: 0.875rem;
    margin-bottom: 1.5rem;
  }
  .posts {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .muted {
    color: var(--text-muted);
  }
</style>
